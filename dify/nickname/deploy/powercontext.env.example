# 复制为实际使用的 .env；data 路径相对于服务启动目录，也可改成绝对路径。
# 用 openssl rand -hex 32 生成令牌，替换下方占位值。
POWERCONTEXT_HOME=./data
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
POWERCONTEXT_SERVER_HTTP_HOST=0.0.0.0
POWERCONTEXT_SERVER_HTTP_PORT=18000
POWERCONTEXT_SERVER_ACCESS_MODE=enforced
POWERCONTEXT_SERVER_AUTH_TOKEN=REPLACE_WITH_RANDOM_TOKEN
